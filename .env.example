# LLM backend (ollama | anthropic | openai). Changing this does NOT require re-ingest.
LLM_PROVIDER=ollama
LLM_MODEL=
TEMPERATURE=0
MAX_TOKENS=1024
OLLAMA_HOST=http://127.0.0.1:11434

# Embeddings are always local sentence-transformers, independent of LLM_PROVIDER.
EMBED_MODEL=all-MiniLM-L6-v2

CHROMA_DIR=.chroma
CHROMA_COLLECTION=dsqa
CHUNK_CHARS=1200
CHUNK_OVERLAP=200
TOP_K=6

# Self-verification / agent loop (A/B these; both are fully wired).
GROUNDING_CHECK=true
MAX_RETRIES=1
MAX_STEPS=4

# Retrieval stages (ablate independently; see RESULTS.md).
EXTRACTOR=pymupdf
USE_BM25=true
USE_RERANK=false
USE_EXPAND=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_POOL=30
CONTEXTUAL=true
CACHE_EMBED=true
CACHE_LLM=false
CACHE_DIR=.cache
GUARDRAILS=true
MAX_QUESTION_CHARS=2000

# Cloud keys — only needed when LLM_PROVIDER is anthropic or openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
